{
  "author": "Sahara Bakers",
  "build": {
    "appId": "com.sahara.bakers",
    "files": [
      "main.js",
      "index.html",
      "styles.css",
      "src/**/*",
      "assets/**/*",
      "build/icon.png"
    ],
    "nsis": {
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "oneClick": false,
      "shortcutName": "Sahara Bakers"
    },
    "productName": "Sahara Bakers",
    "publish": {
      "owner": "zikranqureshi22",
      "provider": "github",
      "releaseType": "release",
      "repo": "sahara-bakers-desktop"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    }
  },
  "dependencies": {},
  "description": "Sahara Bakers \u2014 godown stock system: central warehouse supplying 3 branches. Stock in/out, branch transfers with 80mm thermal bill, purchases, low-stock notices. Offline, local-first. v2.1.0 adds the dark Counter POS (sale, shifts, khata, KOT) for the Counter Manager login.",
  "devDependencies": {
    "electron": "^38",
    "electron-builder": "^26"
  },
  "license": "UNLICENSED",
  "main": "main.js",
  "name": "sahara-bakers",
  "private": true,
  "productName": "Sahara Bakers",
  "scripts": {
    "build": "electron-builder --win nsis",
    "pack": "electron-builder --win --dir",
    "start": "electron .",
    "test": "node tests/db-test.mjs",
    "test:electron": "node tests/test.mjs"
  },
  "version": "2.1.0"
}
